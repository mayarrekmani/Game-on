# Copy this file to .env.local and fill in your values

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Dashboard -> Project Settings -> API -> service_role key.
# SECRET — never expose this with NEXT_PUBLIC_. Only used server-side
# (API routes) to send RSVP-confirmation writes and read member emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# resend.com -> API Keys. Free tier covers a small group's worth of emails.
RESEND_API_KEY=your-resend-api-key
# Must be a domain you've verified in Resend, or use their default
# onboarding@resend.dev sender while testing.
EMAIL_FROM="Game On <onboarding@resend.dev>"

# Any long random string — used to sign one-click email RSVP links.
# Generate one with: openssl rand -hex 32
RSVP_TOKEN_SECRET=replace-with-a-long-random-string

# Used to build links inside emails. Update to your deployed URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
